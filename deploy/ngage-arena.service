[Unit]
Description=N-Gage Arena private server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ngage-arena
Group=ngage-arena
WorkingDirectory=/opt/ngage-arena
ExecStart=/opt/ngage-arena/.venv/bin/python -m arena.runtime --host 0.0.0.0 --http-host 127.0.0.1 --http-port 8192 --data /var/lib/ngage-arena
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ngage-arena
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
